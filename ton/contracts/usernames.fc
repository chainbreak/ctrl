
;; One-day ascending auctions. Outbid TAP becomes withdrawable immediately.
int handle_index(slice text) inline { 
  int bits = slice_bits(text);throw_unless(421,(slice_refs(text) == 0) & (bits >= 32) & (bits <= 40) & ((bits % 8) == 0));
  int index = string_hash(text);throw_unless(422,text~load_uint(8) == 64);
  int initial = text~load_uint(8);throw_unless(422,(initial >= 97) & (initial <= 122));
  while (slice_bits(text) > 0){ int d = text~load_uint(8);throw_unless(422,((d >= 97) & (d <= 122)) | ((d >= 48) & (d <= 57)) | (d == 95)); }
  throw_if(433,(index == "@ceo"H) | (index == "@rbl"H) | (index == "@root"H) | (index == "@sudo"H) | (index == "@rebula"H) | (index == "@ctrl"H) | (index == "@ctrlsup"H) | (index == "@botmather"H) | (index == "@admin"H) | (index == "@support"H) | (index == "@official"H));
  return index;
 }
() recv_internal(int msg_value, cell full, slice body) impure { 
  if (body.slice_empty?()) {  return ();  }
  slice header = full.begin_parse();
  int flags = header~load_uint(4);
  slice sender = header~load_msg_addr();
  var (admin, master, gifts, price, count, nonce, codes, meta, balances, issued, pending) = state();
  slice cs = codes.begin_parse(); cs~load_ref();
  cell wallet_code = cs~load_ref();
  slice vault = calculate_user_jetton_wallet_address(my_address(), master, wallet_code);
  ;; Outgoing withdrawal bounced at the collection's TAP wallet: restore credit once.
  if (flags & 1) { 
    if ((slice_bits(body) < 128) | (~ equal_slices(sender, vault))) {  return ();  }
    body~skip_bits(32);
    if (body~load_uint(32) != 0x0f8a7ea5) {  return ();  }
    int id = body~load_uint(64);
    (slice record, int ok) = pending.udict_get?(64, id);
    if (ok) { 
      slice user = record~load_msg_addr(); int amount = record~load_coins();
      balances = adjust(balances, user, amount);
      pending~udict_delete?(64, id);
      save(admin, master, gifts, price, count, nonce, codes, meta, balances, issued, pending);
     }
    return ();
   }
  int op = body~load_uint(32);
  int query = body~load_uint(64);
  if (op == 0x7362d09c) { 
    throw_unless(401, equal_slices(sender, vault));
    int amount = body~load_coins();
    slice buyer = body~load_msg_addr(); force_chain(buyer);
    balances = adjust(balances, buyer, amount);

  } elseif (op == 0x43544103) {
    throw_unless(401, equal_slices(sender, admin)); throw_unless(424, msg_value >= 120000000);
    slice holder = body~load_msg_addr(); force_chain(holder); int index = string_hash(body);
    throw_unless(433, (index == "@root"H) | (index == "@sudo"H) | (index == "@rebula"H));
    (_, int exists) = issued.udict_get_ref?(256,index); throw_if(425,exists);
    cell n = begin_cell().store_uint(0,8).store_slice(body).end_cell();
    cell fields = new_dict().udict_set_ref(256,"name"H,n);
    cell birth = begin_cell().store_slice(holder).store_ref(begin_cell().store_uint(0,8).store_dict(fields).end_cell()).end_cell();
    issued~udict_set_ref(256,index,birth); count += 1; deliver(index,codes,birth);
  } elseif ((op == 0x43544101) | (op == 0x43544102)) { 
    force_chain(sender);
    throw_unless(424, msg_value >= 120000000);
    slice m = meta.begin_parse();cell info = m~load_ref();cell edition = m~load_ref();
    cell names = m~load_dict();
    int bid = 0;
    if (op == 0x43544101) {  bid = body~load_coins();  }
    int index = handle_index(body);
    (cell birth, int exists) = issued.udict_get_ref?(256,index);
    throw_if(425,exists);
    (cell entry, int started) = names.udict_get_ref?(256,index);
    int deadline = now() + 86400;int highest = 0;slice leader = sender;
    if (started) { slice e = entry.begin_parse();deadline = e~load_uint(32);highest = e~load_coins();leader = e~load_msg_addr(); }
    if (op == 0x43544101) { 
      throw_unless(430,now() < deadline);
      throw_unless(431,(bid >= price) & (bid > highest));
      if (started) {  balances = adjust(balances,leader,highest);  }
      balances = adjust(balances,sender,0 - bid);
      names~udict_set_ref(256,index,begin_cell().store_uint(deadline,32).store_coins(bid).store_slice(sender).end_cell());
     } else { 
      throw_unless(432,started & (now() >= deadline));
      balances = adjust(balances,admin,highest);
      cell n = begin_cell().store_uint(0,8).store_slice(body).end_cell();
      cell fields = new_dict().udict_set_ref(256,"name"H,n);
      cell content = begin_cell().store_uint(0,8).store_dict(fields).end_cell();
      birth = begin_cell().store_slice(leader).store_ref(content).end_cell();
      issued~udict_set_ref(256,index,birth); names~udict_delete?(256,index);
      count += 1; deliver(index,codes,birth);
     }
    meta = begin_cell().store_ref(info).store_ref(edition).store_dict(names).end_cell();
   } elseif (op == 0x43545202) { 
    ;; Idempotent recovery of a downstream initialization failure. The item accepts
    ;; its original initialization only once, even after resale.
    throw_unless(424, msg_value >= 120000000);
    int index = body~load_uint(256);
    (cell birth, int exists) = issued.udict_get_ref?(256, index);
    throw_unless(426, exists); deliver(index, codes, birth);
   } elseif (op == 0x43545203) { 
    throw_unless(424, msg_value >= 150000000);
    int amount = body~load_coins(); throw_unless(427, amount > 0);
    balances = adjust(balances, sender, 0 - amount);
    nonce += 1;
    pending = pending.udict_set_builder(64, nonce, begin_cell().store_slice(sender).store_coins(amount));
    cell transfer = begin_cell().store_uint(0x0f8a7ea5, 32).store_uint(nonce, 64)
      .store_coins(amount).store_slice(sender).store_slice(my_address()).store_uint(0, 1)
      .store_coins(0).store_uint(0, 1).store_uint(0x43545205,32).end_cell();
    send_raw_message(begin_cell().store_uint(0x18, 6).store_slice(vault).store_coins(110000000)
      .store_uint(1, 107).store_ref(transfer).end_cell(), 1);
   } elseif (op == 0x43545204) { 
    throw_unless(401, equal_slices(sender, vault));
    (slice record, int exists) = pending.udict_get?(64, query);
    if (~ exists) {  return ();  }
    slice user = record~load_msg_addr(); int amount = record~load_coins();
    throw_unless(427, body~load_coins() == amount);
    balances = adjust(balances, user, amount);
    pending~udict_delete?(64, query);
   } elseif (op == 0xd53276db) {  return ();
   } elseif (op == 0x43545205) { 
    (slice record, int exists) = pending.udict_get?(64, query);
    if (~ exists) {  return ();  }
    slice user = record~load_msg_addr();
    if (~ equal_slices(sender, calculate_user_jetton_wallet_address(user, master, wallet_code))) {  return ();  }
    pending~udict_delete?(64, query);
   } else {  throw(0xffff);  }
  save(admin, master, gifts, price, count, nonce, codes, meta, balances, issued, pending);
 }

(int, cell, slice) get_collection_data() method_id { 
  var (admin, _, gifts, _, count, _, _, meta, _, _, _) = state();
  return (gifts ? count : -1, meta.begin_parse().preload_ref(), admin);
 }
slice get_nft_address_by_index(int index) method_id { 
  var (_, _, _, _, _, _, codes, _, _, _, _) = state();
  return calculate_jetton_wallet_address(item_init(index, codes));
 }
cell get_nft_content(int index, cell individual) method_id {  return individual;  }
int get_credit(slice owner) method_id { 
  var (_, _, _, _, _, _, _, _, balances, _, _) = state(); return balance(balances, owner);
 }

(int,int,slice) get_auction(int index) method_id { 
  var (_,_,_,_,_,_,_,meta,_,issued,_) = state(); slice m = meta.begin_parse();m~load_ref();m~load_ref();cell auctions = m~load_dict();
  (cell entry,int found) = auctions.udict_get_ref?(256,index);
  if (found){ slice s = entry.begin_parse();return (s~load_uint(32),s~load_coins(),s~load_msg_addr()); }
  (_,int done) = issued.udict_get_ref?(256,index);return (done,0,begin_cell().store_uint(0,2).end_cell().begin_parse());
 }
